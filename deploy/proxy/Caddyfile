# Troque pelo seu subdomínio real. O DNS (registro A) precisa já apontar pro IP da VPS,
# senão o Let's Encrypt não consegue validar e o HTTPS não sai.

{
	email seu-email@exemplo.com
}

agenda.seudominio.com.br {
	encode zstd gzip
	# "agenda-app" é o container_name do app; 3000 é a porta interna do Express
	reverse_proxy agenda-app:3000
}

