# Copie para .env NA VPS (cp .env.production.example .env) e preencha.
# Este arquivo de exemplo pode ir pro git; o .env de verdade NUNCA.
NODE_ENV=production
PORT=3000
TZ=America/Sao_Paulo

# Banco (DB_HOST/DB_PORT são definidos no docker-compose)
DB_NAME=agenda_eletricista
DB_USER=agenda
DB_PASS=troque-por-senha-forte
DB_ROOT_PASS=troque-por-outra-senha-forte

# Gere com: openssl rand -hex 48
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Usuário inicial (perfil secretaria), criado pela migration na primeira subida
SECRETARIA_NOME=
SECRETARIA_LOGIN=
SECRETARIA_SENHA=
